{
  "[nix]": {
    "editor.defaultFormatter": "jnoortheen.nix-ide",
    "editor.formatOnSave": true
  },
  "nix.enableLanguageServer": true,
  "nix.serverPath": "nixd",
  "nix.serverSettings": {
    "nixd": {
      "formatting": {
        "command": [
          "alejandra"
        ]
      },
      "options": {
        "nixos": {
          "expr": "(builtins.getFlake \"/home/munkien/nixos\").nixosConfigurations.pc-anders.options"
        },
        "home-manager": {
          "expr": "(builtins.getFlake \"/home/munkien/nixos\").nixosConfigurations.pc-anders.options.home-manager.users.type.functor.wrapped"
        }
      }
    }
  }
}
